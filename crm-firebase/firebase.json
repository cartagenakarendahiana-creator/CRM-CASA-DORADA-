{
  "hosting": [
    {
      "site": "housechat",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/widget.js",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/catalogo/**",
          "function": {
            "functionId": "catalogoPdf",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/tarjeta/**",
          "function": {
            "functionId": "tarjetaDescuento",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/cotizacion/**",
          "function": {
            "functionId": "cotizacionPdf",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/webchat",
          "function": {
            "functionId": "webchat",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/v1/**",
          "function": {
            "functionId": "api",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/form",
          "function": {
            "functionId": "forms",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/shopify",
          "function": {
            "functionId": "shopifyWebhook",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/media",
          "function": {
            "functionId": "media",
            "region": "us-east1"
          }
        }
      ]
    },
    {
      "site": "crm-casa-dorada",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/widget.js",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/catalogo/**",
          "function": {
            "functionId": "catalogoPdf",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/tarjeta/**",
          "function": {
            "functionId": "tarjetaDescuento",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/cotizacion/**",
          "function": {
            "functionId": "cotizacionPdf",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/webchat",
          "function": {
            "functionId": "webchat",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/v1/**",
          "function": {
            "functionId": "api",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/form",
          "function": {
            "functionId": "forms",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/shopify",
          "function": {
            "functionId": "shopifyWebhook",
            "region": "us-east1"
          }
        },
        {
          "source": "/api/media",
          "function": {
            "functionId": "media",
            "region": "us-east1"
          }
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" install --omit=dev"
      ]
    }
  ]
}
